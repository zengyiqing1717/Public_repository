<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DietRecordMapper">
    
    <resultMap type="DietRecord" id="DietRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="foodName"    column="food_name"    />
        <result property="calories"    column="calories"    />
        <result property="mealType"    column="meal_type"    />
        <result property="recordDate"    column="record_date"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectDietRecordVo">
        select id, user_id, food_name, calories, meal_type, record_date, remark, create_time from diet_record
    </sql>

    <select id="selectDietRecordList" parameterType="DietRecord" resultMap="DietRecordResult">
        <include refid="selectDietRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="foodName != null  and foodName != ''"> and food_name like concat('%', #{foodName}, '%')</if>
            <if test="calories != null "> and calories = #{calories}</if>
            <if test="mealType != null  and mealType != ''"> and meal_type = #{mealType}</if>
            <if test="recordDate != null "> and record_date = #{recordDate}</if>
        </where>
    </select>
    
    <select id="selectDietRecordById" parameterType="Long" resultMap="DietRecordResult">
        <include refid="selectDietRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertDietRecord" parameterType="DietRecord" useGeneratedKeys="true" keyProperty="id">
        insert into diet_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="foodName != null and foodName != ''">food_name,</if>
            <if test="calories != null">calories,</if>
            <if test="mealType != null">meal_type,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="foodName != null and foodName != ''">#{foodName},</if>
            <if test="calories != null">#{calories},</if>
            <if test="mealType != null">#{mealType},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateDietRecord" parameterType="DietRecord">
        update diet_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="foodName != null and foodName != ''">food_name = #{foodName},</if>
            <if test="calories != null">calories = #{calories},</if>
            <if test="mealType != null">meal_type = #{mealType},</if>
            <if test="recordDate != null">record_date = #{recordDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDietRecordById" parameterType="Long">
        delete from diet_record where id = #{id}
    </delete>

    <delete id="deleteDietRecordByIds" parameterType="String">
        delete from diet_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>